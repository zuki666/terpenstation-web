[Unit]
Description=Terpen Station: ponovi neposlane mailove
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trgovina
WorkingDirectory=/home/trgovina/terpenstation-web
ExecStart=/home/trgovina/terpenstation-web/.venv/bin/python -m backend mailovi
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/trgovina/terpenstation-web
PrivateTmp=yes

# Kopirati u /home/trgovina/terpenstation-web/.env i popuniti (README, Server).
# .env nikad ne ide u git, a tajne nikad u chat.

# Drugi app password na sales@terpenstation.com („trgovina”), ne glavna lozinka i ne botov.
# Promjena lozinke Google računa poništi oba app passworda; tada se ovdje upisuje novi.
SMTP_LOZINKA=
# Nasumičan niz za potpis BOX NOW linka u mailu trgovini:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TAJNA_LINKOVA=

# BOX NOW (W4). Dok su prazni, link u mailu javlja da podaci nisu upisani.
# Produkcija za Hrvatsku: https://api-production.boxnow.hr; testno okruženje daje BOX NOW.
BOXNOW_API_URL=
BOXNOW_CLIENT_ID=
BOXNOW_CLIENT_SECRET=
